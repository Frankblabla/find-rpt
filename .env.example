# Export these in your terminal; the application does not load .env automatically.
FIND_RPT_CLAUDE=claude
# Defaults for the UI selectors; each new request snapshots its chosen values.
# Supported models: opus, sonnet, haiku. Supported efforts: low, medium, high.
FIND_RPT_MODEL=opus
FIND_RPT_EFFORT=high
# Extraction: at most three agent turns and 300 seconds (maximum 600). Composition is local.
FIND_RPT_TIMEOUT=300
FIND_RPT_PORT=8765
# Uses Claude subscription login. No API key, Codex fallback, or dollar quota cap.
